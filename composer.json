{
  "name": "nguyentiep91/nt-tao-anh-noi-dung-wordpress",
  "description": "Plugin WordPress tạo và quản lý hình ảnh nội dung bằng AI.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "authors": [
    {
      "name": "Nguyễn Tiệp",
      "homepage": "https://nguyentiep.vn"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
